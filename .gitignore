test
**/.DS_Store

# iTerm2 runtime state (written through the ~/.config/iterm2 link)
macos/iterm2/sockets/

# Karabiner writes timestamped backups next to its config
macos/karabiner/automatic_backups/

# machine-local function overrides
config/zsh/functions/**/*.local.sh

# zsh completion cache lands in $ZDOTDIR
config/zsh/.zcompdump*
